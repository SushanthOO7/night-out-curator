# ============================================================
#  Night-Out Curator environment variables
#  Copy this file to `.env` and configure ONE LLM provider.
#  The baseline runs OFFLINE by default. The data-source keys
#  at the bottom are only needed if you pass `--live`.
# ============================================================

# ---- Pick ONE LLM provider ----------------------------------
# Optional Maps provider comparison; not a Gemini key:
GOOGLE_MAPS_API_KEY=

# LLM_PROVIDER = openai | anthropic | google_genai | ollama | bedrock_converse
LLM_PROVIDER=openai
# Optional. Leave blank to use the provider's default model.
LLM_MODEL=gpt-4o-mini

# OpenAI (default, PAID, needs a billing account)
#   LLM_PROVIDER=openai   LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Anthropic Claude (PAID)
#   LLM_PROVIDER=anthropic   LLM_MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_KEY=

# Google Gemini (FREE tier, NO credit card) via Google AI Studio:
#   get a key at https://aistudio.google.com/apikey
#   LLM_PROVIDER=google_genai   LLM_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=

# Ollama (FREE, local, NO credit card, NO key):
#   install https://ollama.com  then run: ollama pull llama3.1
#   LLM_PROVIDER=ollama   LLM_MODEL=llama3.1
#   (no variable needed)

# AWS Bedrock Claude Haiku 4.5 (credit eligibility and model access required):
#   LLM_PROVIDER=bedrock_converse
#   LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-east-1
# ONE Bedrock API key, or an AWS key pair below; leave unused fields empty.
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required only for temporary AWS credentials:
AWS_SESSION_TOKEN=

# ---- Data-source APIs (ONLY needed for --live) --------------
# All free, no credit card required.
GEOAPIFY_KEY=          # https://myprojects.geoapify.com  (3000 req/day free)
TRANSITLAND_KEY=       # https://www.transit.land         (1000 routes/mo free)
